# Copy file này thành .env tại gốc repo, rồi điền hai mật khẩu local.
# .env được Git bỏ qua; .env.example chỉ chứa mẫu, không chứa secret thật.
MYSQL_ROOT_PASSWORD=
DB_USERNAME=telecom
DB_PASSWORD=

# Dùng khi chạy Java từ IDE/terminal, kết nối qua cổng MySQL trên máy nhà.
# Spring không tự đọc .env: phải cấp các biến này trong Run Configuration/shell.
DB_JDBC_URL=jdbc:mysql://localhost:3306/telecom_dev?connectionTimeZone=UTC
SPRING_PROFILES_ACTIVE=home
