@startuml
!pragma layout smetana
title REVIEW 2026-10-26 - System Context
rectangle "Customer" as Customer
rectangle "CSKH application\nExternal caller" as C
rectangle "Reporting consumer\nExternal caller" as R
rectangle "Keycloak / external IdP\nJWT + JWKS" as I
